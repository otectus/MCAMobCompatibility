# Gradle / ModDevGradle
.gradle/
build/
run/
run-data/
out/
src/generated/resources/.cache/

# Eclipse / IntelliJ / VS Code
*.iml
*.ipr
*.iws
.idea/
.eclipse/
.settings/
.classpath
.project
.vscode/
bin/

# Build/run logs
*.log
*.log.gz
logs/

# Optional-mod jars used only to populate a dev run's mods folder. SWEM and Genetic Animals are
# All Rights Reserved and Guard Villagers' assets are too, so committing any of them would be
# redistribution. The build treats every one of them as optional and degrades when absent, and no
# class here compiles against them, so a fresh clone builds fine with this folder empty.
libs/

# Bootstrap scratch (Forge MDK download used only to seed the Gradle wrapper)
.bootstrap/

# Session summaries (local notes, not part of the published mod)
docs/summaries/

run-client/
run-server/
run-gametest/

# Checked-in validation evidence; runtime worlds/JARs remain excluded.
!docs/validation/*.log
